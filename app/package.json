{
  "name": "the-arc",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/main.ts --outdir dist --target browser",
    "watch": "bun build src/main.ts --outdir dist --target browser --watch",
    "serve": "bun scripts/serve.ts 5173",
    "stills": "bun scripts/render.ts stills",
    "render": "bun scripts/render.ts video --fps 60 --samples 3 --shutter 0.5 --crf 18 --out ../out/the-arc.mp4",
    "render:4k": "bun scripts/render.ts video --scale 2 --fps 60 --samples 3 --shutter 0.5 --crf 18 --out ../out/the-arc-4k.mp4"
  },
  "dependencies": {
    "opentype.js": "^2.0.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/opentype.js": "^1.3.10",
    "@types/three": "^0.186.0",
    "playwright": "^1.63.0"
  }
}
